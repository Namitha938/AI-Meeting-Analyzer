# Meetora Backend Configuration Template
# Copy this file to .env and fill in your values

# Database (SQLite for local dev, or PostgreSQL: postgresql://user:pass@localhost:5432/meetora_db)
DATABASE_URL=sqlite:///./meetora.db

# Authentication Security (JWT)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage Provider (cloudinary, s3, or local)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Redis & Celery (Optional for background workers)
REDIS_URL=redis://localhost:6379/0

# Semantic Vector Search
VECTOR_SEARCH_PROVIDER=cosine
VECTOR_DIMENSION=384

# LiveKit WebRTC Room & Egress Recording
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
LIVEKIT_MAX_PARTICIPANTS=8
MAX_ROOM_PARTICIPANTS=8
RECORDING_RETENTION_DAYS=30
BOT_PROVIDER=mock

# External Meeting AI Bot (mock, recall, vexa)
BOT_NAME="Meetora Notetaker (recording)"
RECALL_API_KEY=your_recall_ai_api_key
RECALL_WEBHOOK_SECRET=your_recall_webhook_secret
RECALL_BASE_URL=https://api.recall.ai/api/v1
VEXA_API_KEY=your_vexa_api_key
VEXA_WEBHOOK_SECRET=your_vexa_webhook_secret
BOT_JOIN_RATE_LIMIT_PER_MINUTE=10
